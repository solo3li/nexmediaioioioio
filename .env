MINIO_EXTERNAL_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_DEFAULT_BUCKET=nexmedia-media
MINIO_USE_SSL=False
