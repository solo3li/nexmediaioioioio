# Django Configuration
SECRET_KEY=django-insecure-nexmedia-dev-key-change-in-production-123456789
DEBUG=True
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://169.58.32.179:8000,http://localhost:8000,http://127.0.0.1:8000

# PostgreSQL Configuration
POSTGRES_DB=nexmedia_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis Configuration (Broker & Cache & PubSub)
